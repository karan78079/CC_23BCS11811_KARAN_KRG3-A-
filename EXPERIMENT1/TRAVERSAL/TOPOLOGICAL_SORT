#include<iostream>
#include<vector>
#include<stack>
using namespace std;

void dfs(int node, vector<vector<int>>& adj, vector<int>& vis, stack<int>& st){
    vis[node] = 1;
    for(auto it : adj[node]){
        if(!vis[it]){
            dfs(it, adj, vis, st);
        }
    }
    st.push(node);
}

int main(){
    int n = 6;
    vector<vector<int>> adj(n);

    adj[5]={2,0};
    adj[4]={0,1};
    adj[2]={3};
    adj[3]={1};

    vector<int> vis(n,0);
    stack<int> st;

    for(int i=0;i<n;i++){
        if(!vis[i]) dfs(i, adj, vis, st);
    }

    while(!st.empty()){
        cout<<st.top()<<" ";
        st.pop();
    }
}
