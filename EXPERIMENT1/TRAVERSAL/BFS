#include<iostream>
#include<vector>
#include<queue>
using namespace std;

int main(){
    int n = 5;
    vector<vector<int>> adj(n);
    
    adj[0] = {1,2};
    adj[1] = {0,3};
    adj[2] = {0,4};
    adj[3] = {1};
    adj[4] = {2};

    vector<int> vis(n,0);
    queue<int> q;

    q.push(0);
    vis[0] = 1;

    while(!q.empty()){
        int node = q.front();
        q.pop();
        cout << node << " ";

        for(auto it : adj[node]){
            if(!vis[it]){
                vis[it] = 1;
                q.push(it);
            }
        }
    }
}
