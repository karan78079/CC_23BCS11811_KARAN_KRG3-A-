#include<iostream>
using namespace std;
#include<algorithm>
#include<climits>
#include<vector>

int main(){
    int n;
    cin>>n;

    vector<int> token(n);

    for(int i=0; i<n; i++){
        cin>>token[i];
    }

    int power;
    cin>>power;


    sort(token.begin() , token.end());

    int i = 0;

    int j = n-1;
int maxScore = 0;
    int score = 0;

    while(i<=j){
        if(power>=token[i]){
            power  = power-token[i];
            score++;
            maxScore = max(maxScore , score);
            i++;
        }

        else if(score>0){
            power+=token[j];
            score--;
            j--;

        }

        else{
            break;
        }

    }


    cout<<maxScore;






    return 0;
}


